generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa para `prisma migrate`: las migraciones necesitan una
  // sesión persistente y no funcionan a través de PgBouncer en modo transaction.
  directUrl = env("DIRECT_URL")
}

model User {
  id                String           @id @default(cuid())
  handle            String           @unique
  name              String
  avatar            String           @default("🐺")
  bio               String?
  wallet            String?
  passwordHash      String? // hash scrypt (login/registro por credenciales; null = cuenta demo/sin password)
  walletVerified    Boolean          @default(false)
  xHandle           String?
  xVerified         Boolean          @default(false)
  googleEmail       String?
  googleVerified    Boolean          @default(false)
  tgHandle          String?
  isDev             Boolean          @default(false)
  cabalScore        Int              @default(0)
  // Reputación de la comunidad (👍/👎, ver lib/reputation.ts). Se guardan aquí
  // ya calculados para poder enseñar la insignia en cualquier lista sin pedir
  // las valoraciones una por una; la fuente de verdad son las filas Reputation.
  repUp             Int              @default(0) // votos positivos (sin ponderar)
  repDown           Int              @default(0) // votos negativos (sin ponderar)
  repScore          Int              @default(50) // % de confianza ponderado y suavizado
  callsWon          Int              @default(0)
  callsTotal        Int              @default(0)
  followers         Int              @default(0)
  isCurrentUser     Boolean          @default(false)
  isAdmin           Boolean          @default(false)
  points            Int              @default(0)
  // Con cuánta antelación avisa la campanita de un launch, en minutos. Son
  // varias a la vez: quien quiera aviso a 1 h y otro a 5 min los tiene los dos.
  // Es del usuario porque su aviso va a su chat privado y a su correo; el de un
  // grupo lo decide el grupo (ChatLink.reminderLeads).
  reminderLeads     Int[]            @default([60])
  lifetimePoints    Int              @default(0)
  referralCode      String?          @unique
  referredById      String?
  referredBy        User?            @relation("ReferralTree", fields: [referredById], references: [id])
  referrals         User[]           @relation("ReferralTree")
  // Correo de la cuenta: seguridad (códigos por correo) y contacto (GHL). No es
  // único en la base: dos cuentas pueden escribir el mismo sin verificarlo, y
  // gana la primera que lo verifica (la unicidad se comprueba al verificar).
  email             String?
  emailVerified     Boolean          @default(false)
  // Pide un código por correo al iniciar sesión con usuario y contraseña
  twoFactorEnabled  Boolean          @default(false)
  // Cliente de Stripe, para abrir su portal de facturación
  stripeCustomerId  String?          @unique
  // Sincronización con Go High Level (contacto etiquetado "Cabal")
  ghlContactId      String?
  ghlSyncedAt       DateTime?
  ghlError          String?
  // Avisos de lanzamientos por correo (perk Premium): activado por defecto,
  // el usuario lo puede apagar. Sin correo verificado o sin Premium no llega
  // nada de todos modos (ver lib/launch-alerts.ts).
  notifyEmail       Boolean          @default(true)
  // Verificación oficial de Cabal (insignia + destello en el avatar). "admin" =
  // la dio el admin y es permanente; "premium" = aprobada a partir de una
  // solicitud Premium: el worker la apaga si deja de pagar y la vuelve a
  // encender si renueva (ver lib/verification.ts).
  verified          Boolean          @default(false)
  verifiedVia       String? // admin | premium
  createdAt         DateTime         @default(now())
  posts             Post[]
  launches          Launch[]
  tokens            Token[]
  votes             Vote[]
  followersRel      Follow[]         @relation("followTarget")
  followingRel      Follow[]         @relation("followUser")
  pointEvents       PointEvent[]
  wallets           WalletLink[]
  devClaims         DevClaim[]
  projectClaims     ProjectClaim[]
  subscriptions     Subscription[]
  payments          Payment[]
  emailCodes        EmailCode[]
  launchMemberships LaunchMember[]   @relation("launchMember")
  launchInvitesSent LaunchMember[]   @relation("launchInviter")
  chatMessages      ChatMessage[]
  launchReminders   LaunchReminder[]
  chatLinks         ChatLink[]
  chatLinkCodes     ChatLinkCode[]
  repReceived       Reputation[]     @relation("repTarget")
  repGiven          Reputation[]     @relation("repAuthor")
  verifyRequests    VerificationRequest[]

  @@index([points])
  @@index([repScore])
  @@index([referredById])
  @@index([createdAt])
  @@index([email])
}

// Valoración de un usuario por otro: 👍 confío / 👎 no confío, con una reseña
// escrita opcional. Una fila por par (autor, valorado): volver a votar cambia
// el voto en vez de sumar otro, y retirarlo borra la fila.
//
// "weight" se congela al votar (ver repWeight): el voto de una cuenta
// verificada y con recorrido pesa más, y que no cambie después evita que el
// porcentaje de un dev se mueva solo porque alguien que le votó hace meses
// acaba de verificar su wallet.
model Reputation {
  id        String   @id @default(cuid())
  targetId  String
  target    User     @relation("repTarget", fields: [targetId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("repAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  value     Int // 1 = confío | -1 = no confío
  weight    Int      @default(1)
  body      String   @default("") // reseña opcional
  hidden    Boolean  @default(false) // ocultada por moderación: no cuenta ni se lista
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, targetId])
  @@index([targetId, hidden, createdAt])
  @@index([authorId])
}

model Launch {
  id             String           @id @default(cuid())
  name           String
  ticker         String?
  emoji          String           @default("🚀")
  image          String?
  banner         String?
  isPrivate      Boolean          @default(false)
  hidden         Boolean          @default(false)
  submitterRole  String           @default("community") // dev = lo sube su propio dev | community = scout que comparte info
  contract       String? // CA del token si ya fue desplegado (para gráfico en vivo)
  // Datos premium: su visibilidad la decide el admin (ver lib/premium.ts)
  devWallet      String? // wallet del dev, si se conoce
  launchpad      String? // plataforma donde sale el token (pump.fun, Zora…)
  network        String           @default("solana")
  launchAt       DateTime
  dateConfirmed  Boolean          @default(true) // false = fecha estimada por quien sube el proyecto, no confirmada por el equipo
  description    String
  website        String?
  twitter        String?
  telegram       String?
  isLive         Boolean          @default(false) // el launch se emite/emitirá en vivo (streaming): activa el video incrustado en la ficha
  liveUrl        String? // link del stream (YouTube, Twitch, Vimeo…) para incrustar en el detalle
  status         String           @default("upcoming")
  hype           Int              @default(0)
  lpLocked       Boolean          @default(false)
  mintRevoked    Boolean          @default(false)
  top10Pct       Float            @default(25)
  createdById    String
  createdAt      DateTime         @default(now())
  // Última edición con cambios de verdad (no se toca si se guarda sin cambiar nada),
  // para mostrarla como actividad reciente ("actualizó la fecha", "cambió la descripción"…)
  lastEditedAt   DateTime?
  lastChangeNote String?
  // Launch oficial (ver User.verified): marca frente a clones
  verified       Boolean          @default(false)
  verifiedVia    String? // admin | premium
  createdBy      User             @relation(fields: [createdById], references: [id])
  posts          Post[]
  token          Token?
  members        LaunchMember[]
  reminders      LaunchReminder[]
  verifyRequests VerificationRequest[]

  @@index([status, launchAt])
  @@index([createdById])
  @@index([contract])
}

// Equipo de un launch: el dev invita a otros usuarios con un rol (Programador,
// Team, Moderador…). La invitación no cuenta hasta que el invitado la acepta,
// para que nadie aparezca en el equipo de un proyecto sin quererlo.
model LaunchMember {
  id          String    @id @default(cuid())
  launchId    String
  launch      Launch    @relation(fields: [launchId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("launchMember", fields: [userId], references: [id])
  role        String // programador | team | moderador (ver lib/launch-team.ts)
  status      String    @default("pending") // pending | accepted | declined
  invitedById String
  invitedBy   User      @relation("launchInviter", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([launchId, userId])
  @@index([userId, status])
}

// Acceso premium. Una fila por suscripción de Stripe, por pago en cripto
// (NOWPayments) o por concesión manual del admin. El usuario es premium
// mientras tenga alguna fila activa con el periodo en curso.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  provider             String // stripe | nowpayments | admin
  plan                 String // monthly | biannual | annual | custom
  status               String // active | trialing | past_due | canceled | unpaid | incomplete | incomplete_expired | paused
  currentPeriodEnd     DateTime? // null = sin caducidad (solo concesiones del admin)
  cancelAtPeriodEnd    Boolean   @default(false)
  stripeSubscriptionId String?   @unique
  // Fecha del último evento de Stripe aplicado: los webhooks pueden llegar
  // desordenados y uno viejo no debe pisar un estado más reciente.
  stripeEventAt        DateTime?
  paymentId            String?   @unique // pago en cripto que la originó
  note                 String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
}

// Cada cobro: facturas de Stripe (pagadas o fallidas) y facturas de
// NOWPayments desde que se crean hasta que se pagan. Es el historial del admin
// y el ancla idempotente de las notificaciones de los proveedores.
model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  provider          String // stripe | nowpayments
  plan              String
  amountUsd         Float
  // stripe: paid | failed · nowpayments: waiting | confirming | confirmed |
  // sending | partially_paid | finished | failed | refunded | expired
  status            String
  externalId        String? // id de la factura en el proveedor
  providerPaymentId String? // payment_id de NOWPayments
  payCurrency       String?
  actuallyPaid      Float?
  invoiceUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Códigos de seguridad enviados por correo (verificar el correo, entrar con
// 2FA, activar o desactivar el 2FA). Se guarda el hash, nunca el código.
model EmailCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String // verify_email | login | two_factor
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

// Marca que el aviso "faltan <threshold> minutos" de un launch ya se mandó.
// La fila se crea ANTES de enviar los correos (create falla con la
// restricción única si otra pasada ya la reservó): así dos ejecuciones del
// worker nunca mandan el mismo aviso dos veces.
model LaunchAlert {
  id        String   @id @default(cuid())
  launchId  String
  threshold Int // minutos de antelación: 10, 5…
  sentCount Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([launchId, threshold])
}

model Token {
  id         String   @id @default(cuid())
  name       String
  ticker     String
  emoji      String   @default("🪙")
  image      String?
  network    String   @default("solana")
  price      Float    @default(0.0001)
  mc         Float    @default(0)
  change24h  Float    @default(0)
  volume24h  Float    @default(0)
  holders    Int      @default(0)
  top10Pct   Float    @default(25)
  contract   String   @default("")
  // Opcional: un token publicado por un scout no tiene dev hasta que alguien
  // lo reclama y se verifica on-chain. Así el historial de un dev solo recoge
  // lo que de verdad lanzó, no lo que otros encontraron.
  devId      String?
  dev        User?    @relation(fields: [devId], references: [id])
  // Launch del Radar del que salió este token, si vino de ahí (da el
  // "publicado por" y evita crear el mismo token dos veces).
  launchId   String?  @unique
  launch     Launch?  @relation(fields: [launchId], references: [id])
  launchedAt DateTime
  athMc      Float    @default(0)
  isRug      Boolean  @default(false)
  // Token oficial, marcado por el admin. También cuenta como oficial si su
  // launch del Radar está verificado.
  verified   Boolean  @default(false)
  posts      Post[]

  @@index([devId])
  @@index([contract])
  @@index([launchedAt])
}

// Chat en vivo global del Cabal (una sola sala). Presencia (quién está
// conectado) va por Pusher, no por aquí; esta tabla es solo el historial.
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  // Respuesta puntual a otro mensaje del chat. Si el original se borra, la
  // respuesta queda sin cita en vez de desaparecer.
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReplies")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Post {
  id              String    @id @default(cuid())
  kind            String    @default("comment") // thesis | comment | call | trade
  content         String
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  launchId        String?
  launch          Launch?   @relation(fields: [launchId], references: [id])
  tokenId         String?
  token           Token?    @relation(fields: [tokenId], references: [id])
  contract        String? // CA del token: obligatorio para kind == "call"
  network         String? // red del CA: obligatoria para kind == "call"
  // Chat del que nació la call (bot de Telegram/Discord); null = desde la web.
  // Con esto salen el leaderboard filtrado por comunidad y el "first call":
  // si ese token ya se llamó en ese chat, no se crea otra call repetida.
  chatLinkId      String?
  chatLink        ChatLink? @relation(fields: [chatLinkId], references: [id], onDelete: SetNull)
  // Precio/MC del token en el instante exacto de la call (createdAt ya trae
  // hora:min:seg). Se capturan al crear el post — null si DexScreener no
  // respondió a tiempo, o si el post es de antes de esta columna, en cuyo
  // caso el resultado se reconstruye estimando con velas históricas.
  entryPriceUsd   Float?
  entryMc         Float?
  // Resultado guardado de la call (lo rellena lib/call-results en segundo
  // plano). peakMultiple = precio máximo desde la call / precio de entrada;
  // currentMultiple = precio en la última revisión / entrada. A los 30 días
  // se deja de revisar (resultFinal) y el resultado queda fijo.
  peakMultiple    Float?
  currentMultiple Float?
  resultSymbol    String?
  resultImage     String?
  resultCheckedAt DateTime?
  resultFinal     Boolean   @default(false)
  likes           Int       @default(0)
  pnl             Float?
  createdAt       DateTime  @default(now())

  @@index([launchId, createdAt])
  @@index([tokenId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([kind, resultFinal, resultCheckedAt])
  @@index([kind, createdAt])
  @@index([chatLinkId, kind, createdAt])
  @@index([chatLinkId, contract])
}

model Vote {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  target   String // "launch" | "post"
  targetId String

  @@unique([userId, target, targetId])
  @@index([target, targetId])
}

model PointEvent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  amount       Int
  reason       String // thesis | comment | launch | like_received | hype_received | admin_adjust | redeem
  note         String?
  // En los "referral": el afiliado cuyos puntos generaron este bonus
  sourceUserId String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason, sourceUserId])
  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

// Plataformas de trading afiliadas (GMGN, Axiom, Photon…). El admin pega el
// enlace madre de referido; los botones "Comprar" redirigen allí. Soporta el
// placeholder {ca} para inyectar el contrato del token y {red} para la cadena.
// "links" guarda un enlace de referido POR RED (JSON red→url), porque cada
// plataforma usa rutas distintas: gmgn.ai/{red}/token/{ca}, axiom.trade/t/{ca}/…?chain={red}
model AffiliatePlatform {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  url       String   @default("")
  links     String   @default("{}")
  active    Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Follow {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("followUser", fields: [userId], references: [id])
  targetId String
  target   User   @relation("followTarget", fields: [targetId], references: [id])

  @@unique([userId, targetId])
  @@index([targetId])
}

// Wallets conectadas por el usuario (Phantom/MetaMask/dirección pegada).
// "signature" = la firma del mensaje fue verificada criptográficamente
// (Solana ed25519 con tweetnacl; EVM personal_sign con ecrecover de ethers).
model WalletLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  network   String // solana | ethereum | base | bsc | tron | robinhood | arc
  address   String
  label     String   @default("") // Phantom, MetaMask, manual…
  signature Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, network, address])
}

// Verificación de "fui el dev de ese token": el usuario reclama un CA
// antiguo; el backend consulta DexScreener/GeckoTerminal y guarda las
// métricas reales (MC, ATH, liquidez, volumen) en "stats" (JSON).
model DevClaim {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  network       String
  contract      String
  walletAddress String
  name          String    @default("")
  symbol        String    @default("")
  status        String    @default("pending") // verified | pending
  note          String    @default("")
  stats         String    @default("{}")
  source        String    @default("dexscreener")
  createdAt     DateTime  @default(now())
  verifiedAt    DateTime?

  @@unique([userId, network, contract])
  @@index([userId])
  @@index([status])
}

// Reclamo de propiedad de un proyecto de la plataforma (launch o token).
// El usuario pega el CA, conecta su wallet y el backend verifica on-chain
// (Solana: mint authority / Metaplex update authority). Si no se puede
// verificar automáticamente, queda "pending" para revisión del admin.
model ProjectClaim {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  targetType String // "launch" | "token"
  targetId   String
  network    String
  contract   String
  wallet     String
  status     String    @default("pending") // verified | pending | rejected
  method     String    @default("manual") // onchain | admin | manual
  note       String    @default("")
  createdAt  DateTime  @default(now())
  verifiedAt DateTime?

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([status])
}

// Lista de espera (whitelist) previa al lanzamiento público de cabal.army.
// El usuario entra en /whitelist, autoriza con su cuenta de X (OAuth 2.0 +
// PKCE, mismo flujo que /api/auth/x) y queda registrado aquí. El admin ve
// todas las entradas en el panel y habilita manualmente a quien quiera
// (approved = true). "userId" apunta a la cuenta Cabal creada de paso, para
// que el aprobado ya pueda entrar el día del lanzamiento sin registrarse.
model WaitlistEntry {
  id          String    @id @default(cuid())
  xId         String    @unique // id numérico estable de X (el @handle puede cambiar)
  xHandle     String
  xName       String    @default("")
  xAvatar     String?
  xFollowers  Int       @default(0)
  xVerified   Boolean   @default(false) // badge azul en X, no "verificado por nosotros"
  xCreatedAt  DateTime? // antigüedad de la cuenta de X: señal anti-bot
  userId      String?   @unique
  // Datos del formulario que el usuario completa DESPUÉS de autenticarse con X.
  // El email no lo entrega la API de X con OAuth 2.0 (solo OAuth 1.0a con
  // permiso elevado), así que lo escribe la persona; nombre y @handle llegan
  // prellenados del perfil real y el handle no es editable.
  email       String    @default("")
  telegram    String    @default("")
  wallet      String    @default("")
  country     String    @default("")
  reason      String    @default("") // "por qué quieres entrar" (texto libre)
  completed   Boolean   @default(false) // ya envió el formulario
  completedAt DateTime?
  status      String    @default("approved") // pending | approved | rejected
  shared      Boolean   @default(false) // pulsó "Compartir en X" al menos una vez
  sharedAt    DateTime?
  referredBy  String? // handle de quien lo invitó (?ref= en la landing)
  note        String    @default("") // notas internas del admin
  ip          String    @default("")
  userAgent   String    @default("")
  createdAt   DateTime  @default(now())
  approvedAt  DateTime?

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([xHandle])
  @@index([completed])
}

// Comisión de Cabal al comprar/vender un token sin salir de la plataforma
// (Jupiter en Solana; otras redes cuando se agreguen). Una fila por red.
// "feeBps" es la comisión estándar; por debajo de "smallTradeUsd" se cobra
// "smallTradeFeeBps" en su lugar — igual que hace FOMO, para no cobrar de
// más en operaciones chiquitas donde el costo de blockchain ya pesa bastante.
model SwapFeeConfig {
  id               String   @id @default(cuid())
  network          String   @unique
  enabled          Boolean  @default(false)
  feeBps           Int      @default(37)
  smallTradeUsd    Float    @default(10)
  smallTradeFeeBps Int      @default(5)
  referralAccount  String   @default("")
  feeWallet        String   @default("") // solo informativo, para mostrarlo en el panel
  note             String   @default("") // texto que ve la comunidad (tooltip del panel de compra)
  updatedAt        DateTime @updatedAt
}

// Intención de swap: se crea al armar la transacción (build/sell), y se
// consume cuando /api/swap/confirm verifica que de verdad se ejecutó
// on-chain. Existe para no poder "farmear" puntos de afiliado llamando al
// build sin firmar/mandar nada nunca — solo se dan puntos a una intención
// real, confirmada en la blockchain.
model SwapIntent {
  id            String   @id @default(cuid())
  network       String
  kind          String // buy | sell
  walletAddress String
  mint          String
  amountUsd     Float
  feeUsd        Float
  consumed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([walletAddress, createdAt])
}

// Campanita de un launch: el usuario pide que le avisen cuando falte poco
// (1 hora, ver lib/notifications.ts). El aviso llega a su Telegram vinculado
// y a su correo verificado.
model LaunchReminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  launchId  String
  launch    Launch   @relation(fields: [launchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, launchId])
  @@index([launchId])
}

// Chat externo conectado a una cuenta de Cabal: el privado del usuario con el
// bot, o un grupo/canal donde el usuario metió el bot. provider deja la puerta
// abierta a Discord (chatId = id del canal) sin otra tabla.
model ChatLink {
  id              String   @id @default(cuid())
  provider        String // telegram | discord
  chatId          String // id del chat en el proveedor (texto: los de Telegram no caben en Int)
  chatType        String // private | group | supergroup | channel
  title           String?
  userId          String // cuenta de Cabal que lo vinculó
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalUserId  String? // id en el proveedor de quien lo vinculó (para permitirle /settings)
  // Discord: id del servidor del canal (en Telegram el chat ya es el grupo).
  // Sirve para contar comunidades y para las métricas del panel admin.
  serverId        String?
  lang            String   @default("es") // es | en: idioma de los mensajes del bot en este chat
  // Qué se manda a este chat. La campanita de un launch llega siempre al
  // privado del usuario, sin depender de estas opciones.
  notifyLaunches  Boolean  @default(true) // lanzamiento nuevo publicado
  notifyReminders Boolean  @default(true) // "sale pronto", de todos los launches
  notifyCalls     Boolean  @default(false) // calls nuevas publicadas en Cabal
  reminderLeads   Int[]    @default([60]) // minutos de antelación de ese aviso
  notifyTheses    Boolean  @default(false) // tesis nuevas del feed
  active          Boolean  @default(true) // false = el bot fue expulsado o bloqueado
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Calls que nacieron en este chat (leaderboard por comunidad)
  posts           Post[]

  @@unique([provider, chatId])
  @@index([userId])
  @@index([provider, active])
  @@index([provider, serverId])
}

// Código de un solo uso para vincular un chat: la web lo genera con la sesión
// del usuario y el bot lo recibe en /start. Se guarda el hash, no el código.
model ChatLinkCode {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String // telegram | discord
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// Reserva de cada envío masivo ("launch:new:<id>", "post:<id>"…). Se crea ANTES
// de mandar: si dos pasadas del worker se solapan, la segunda choca con la
// clave y no repite el aviso.
model NotificationDispatch {
  key       String   @id
  sentCount Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Solicitud de verificación (perk Premium): el usuario pide verificar su perfil
// o uno de sus launches y el admin la aprueba o la rechaza.
model VerificationRequest {
  id         String    @id @default(cuid())
  kind       String // user | launch
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  launchId   String?
  launch     Launch?   @relation(fields: [launchId], references: [id], onDelete: Cascade)
  note       String    @default("") // pruebas que aporta: web oficial, X del proyecto…
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
  @@index([launchId])
}
