# ==============================================================
# Cabal - variables de entorno
# Copia este archivo a .env y ajusta los valores
#   cp .env.example .env
# ==============================================================

# --- PostgreSQL ---
# Conexión que usa la app. Con pooler (PgBouncer / Neon / Supabase) apunta AQUÍ
# al pooler y añade pgbouncer=true: en modo transaction Prisma debe desactivar
# los prepared statements o las consultas fallan de forma intermitente.
DATABASE_URL=postgresql://cabal:PASSWORD@127.0.0.1:5432/cabal?schema=public&connection_limit=10

# Conexión DIRECTA, sin pooler. La usan `prisma migrate` (necesita una sesión
# persistente) y `db:backup`. Sin pooler, es la misma URL sin los extras.
DIRECT_URL=postgresql://cabal:PASSWORD@127.0.0.1:5432/cabal?schema=public

# Ejemplo con PgBouncer delante (docker-compose.yml lo expone en 6432):
# DATABASE_URL=postgresql://cabal:PASSWORD@127.0.0.1:6432/cabal?schema=public&pgbouncer=true&connection_limit=10
# DIRECT_URL=postgresql://cabal:PASSWORD@127.0.0.1:5432/cabal?schema=public

# --- Redis ---
# Caché de leaderboard/feeds, rate limiting, contadores de hype/likes y Pub/Sub.
# Si se omite, la app funciona igual pero sin caché ni rate limiting: todo va
# directo a Postgres.
REDIS_URL=redis://127.0.0.1:6379
# Con contraseña o TLS (Upstash, Redis Cloud):
# REDIS_URL=rediss://default:PASSWORD@host:6379

# --- Infraestructura local (docker-compose.yml) ---
# Contraseña de Postgres que levanta docker compose. Debe coincidir con la de
# DATABASE_URL y DIRECT_URL.
# POSTGRES_PASSWORD=cabal_dev

# Carpeta de los binarios de Postgres, si pg_dump no está en el PATH
# (necesario para `bun run db:backup`).
# PG_BIN=C:/Users/TU-USUARIO/AppData/Local/com.tinyapp.DBngin/Binaries/postgresql/17.0/bin

# Segundos entre volcados de contadores de Redis a Postgres (counters:watch).
# FLUSH_INTERVAL=15

# --- Autenticación ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Origen de la app ---
# En producción: http://TU-IP:3000 o https://tudominio.com
APP_ORIGIN=http://localhost:3000

# --- Lista de espera (whitelist) ---
# Dominio público que aparece en el post que los usuarios comparten en X y en
# los metadatos Open Graph de la landing. Sin definir se usa https://cabal.army
# NEXT_PUBLIC_SITE_URL=https://cabal.army

# --- Panel de administración (opcional) ---
# Si no las defines, se usan valores por defecto del código.
# Cámbialas en producción.
# ADMIN_USER=admin
# ADMIN_PASSWORD=cambia-esto
# ADMIN_SECRET=cambia-esto

# --- Integraciones OAuth (opcionales) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# --- Solana (opcional) ---
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Go High Level (opcional) ---
# Sincroniza cada cuenta con correo verificado como contacto en GHL con la
# etiqueta "Cabal" (configurable). Sin GHL_LOCATION_ID y GHL_PRIVATE_TOKEN la
# integración queda desactivada (no-op) sin romper nada.
# GHL_LOCATION_ID=
# GHL_PRIVATE_TOKEN=
# GHL_TAG=Cabal
# GHL_WORKFLOW_ID=

# --- Correo (verificación de cuenta, 2FA y avisos Premium) ---
# Uno de los dos basta; si están ambas se prueba Brevo primero.
# BREVO_API_KEY=
# RESEND_API_KEY=

# --- Plan Premium: Stripe (tarjeta) ---
# Secret key (sk_… o rk_…) y el whsec_… del endpoint /api/webhooks/stripe
# (Dashboard > Developers > Webhooks). Cada plan es un Product en Stripe;
# Checkout crea el precio en línea con el importe del panel de admin.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRODUCT_MONTHLY=
# STRIPE_PRODUCT_BIANNUAL=
# STRIPE_PRODUCT_ANNUAL=

# --- Plan Premium: NOWPayments (cripto) ---
# API key y el secreto con el que firman las notificaciones (IPN). La URL de
# notificación va en cada factura, no hay que configurarla en su panel.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io/v1 (para pruebas)
