# ==============================================================
# Cabal - variables de entorno
# Copia este archivo a .env y ajusta los valores
#   cp .env.example .env
# ==============================================================

# --- Base de datos ---
# OPCIÓN A (actual, desarrollo): SQLite.
# Usa la ruta ABSOLUTA donde clonaste el proyecto.
DATABASE_URL=file:/root/cabal/db/custom.db

# OPCIÓN B (producción): PostgreSQL. Ver docs/PRD-postgres-redis.md
# Requiere cambiar `provider` a "postgresql" en prisma/schema.prisma.
#
# Conexión que usa la app. Si hay pooler (PgBouncer / Neon / Supabase),
# apunta AQUÍ al pooler y añade pgbouncer=true para que Prisma desactive
# los prepared statements, incompatibles con el modo transaction.
# DATABASE_URL=postgresql://cabal:PASSWORD@localhost:6432/cabal?schema=public&pgbouncer=true&connection_limit=10
#
# Conexión DIRECTA a Postgres (sin pooler). La usa `prisma migrate`, que
# necesita una sesión persistente. Omítela solo si no usas pooler.
# DIRECT_URL=postgresql://cabal:PASSWORD@localhost:5432/cabal?schema=public

# --- Redis (opcional) ---
# Caché de leaderboard/feeds, rate limiting, contadores y Pub/Sub.
# Si no se define, la app funciona sin caché (todo va a Postgres).
# REDIS_URL=redis://localhost:6379
# Con contraseña o TLS (Upstash, Redis Cloud):
# REDIS_URL=rediss://default:PASSWORD@host:6379

# --- Infraestructura local (docker-compose.yml) ---
# Contraseña de Postgres que levanta docker compose. Debe coincidir con la
# que uses en DATABASE_URL y DIRECT_URL.
# POSTGRES_PASSWORD=cabal_dev

# Segundos entre volcados de contadores de Redis a Postgres (counters:watch).
# FLUSH_INTERVAL=15

# --- Autenticación ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Origen de la app ---
# En producción: http://TU-IP:3000 o https://tudominio.com
APP_ORIGIN=http://localhost:3000

# --- Panel de administración (opcional) ---
# Si no las defines, se usan valores por defecto del código.
# Cámbialas en producción.
# ADMIN_USER=admin
# ADMIN_PASSWORD=cambia-esto
# ADMIN_SECRET=cambia-esto

# --- Integraciones OAuth (opcionales) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# --- Solana (opcional) ---
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
